;
; PIO を使った 8N1 UART 受信プログラム
; クロック周波数: 8 × ボーレート に設定すること
; IN ピン・JMP ピン: どちらも RX に割り当てる
;

.program uart_rx

start:
    wait 0 pin 0        ; スタートビット（Low）まで待機
    set x, 7    [10]    ; 8ビットカウンタをセット、最初のビット中央までディレイ
bitloop:
    in pins, 1          ; データビットをサンプリング
    jmp x-- bitloop [6] ; 8回繰り返し（1ビット = 8サイクル）
    push noblock        ; FIFO に書き込む（フル時は捨てる）

% c-sdk {
#include "hardware/clocks.h"

static inline void uart_rx_program_init(PIO pio, uint sm, uint offset, uint pin, uint baud) {
    pio_gpio_init(pio, pin);                              // GPIO を PIO モードに切り替え
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, false);
    gpio_pull_up(pin);  // アイドル時 High を保証
    pio_sm_config c = uart_rx_program_get_default_config(offset);
    sm_config_set_in_pins(&c, pin);
    sm_config_set_jmp_pin(&c, pin);
    // LSB ファーストで右シフト、オートプッシュ無効
    sm_config_set_in_shift(&c, true, false, 32);
    // TX を使わないので RX FIFO を 8 エントリに拡張
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    // 1 ビット = 8 サイクルになるようクロック分周
    float div = (float)clock_get_hz(clk_sys) / (8 * baud);
    sm_config_set_clkdiv(&c, div);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

static inline bool uart_rx_program_readable(PIO pio, uint sm) {
    return !pio_sm_is_rx_fifo_empty(pio, sm);
}

// FIFO の上位バイトから 8 ビットを取り出す（LSB ファースト・右詰め）
static inline char uart_rx_program_getc(PIO pio, uint sm) {
    io_rw_8 *rxfifo_shift = (io_rw_8*)&pio->rxf[sm] + 3;
    while (pio_sm_is_rx_fifo_empty(pio, sm))
        tight_loop_contents();
    return (char)*rxfifo_shift;
}
%}
